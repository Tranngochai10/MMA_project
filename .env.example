PORT=5000
NODE_ENV=development
# Public backend origin for uploaded images, without /api
PUBLIC_BASE_URL=http://localhost:5000

# MongoDB connection
MONGODB_URI=mongodb://127.0.0.1:27017/voucher_platform
MONGODB_DB_NAME=voucher_platform

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Enable after verifying the MBBank account number and beneficiary name.
MB_PAYMENT_ENABLED=false
MB_ACCOUNT_NUMBER=
MB_ACCOUNT_NAME=
# Payments require MongoDB replica set / Atlas transactions.
